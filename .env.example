SECRET_KEY=change-me-to-a-long-random-secret
PRODUCTION=False
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

DB_NAME=kodehax_academy
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
# Production: use your separate MySQL provider's reachable DNS host, not localhost.
# Enable verified TLS when your provider requires it; empty CA uses system roots.
DB_SSL_REQUIRED=False
DB_SSL_CA=

# Production durable media storage (S3-compatible object storage).
# Ignored while PRODUCTION=False, where uploads use the local media/ folder.
# Production refuses to start unless the three required values below are set.
# Keep credentials private; never commit real values. Endpoint/region are only
# needed for non-AWS S3-compatible providers.
MEDIA_STORAGE_BUCKET_NAME=
MEDIA_STORAGE_ACCESS_KEY_ID=
MEDIA_STORAGE_SECRET_ACCESS_KEY=
MEDIA_STORAGE_ENDPOINT_URL=
MEDIA_STORAGE_REGION_NAME=
MEDIA_STORAGE_QUERYSTRING_EXPIRE=3600

# Preferred in production: Brevo transactional email over HTTPS.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@example.com
BREVO_SENDER_NAME=Kodehax Academy
BREVO_API_TIMEOUT=10

# Optional SMTP fallback for local development when Brevo API variables are empty.
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-brevo-smtp-username
EMAIL_HOST_PASSWORD=your-brevo-smtp-key
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@example.com

GROQ_API_KEY=
GROQ_TEXT_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
TIME_ZONE=Asia/Kolkata
DAILY_CHALLENGE_TIMEZONE=Asia/Kolkata
DAILY_CHALLENGE_PUBLISH_HOUR=10

# Render native runtime versions (set in Render Environment).
# PYTHON_VERSION=3.12.12
# NODE_VERSION=22.16.0
# Explicit override is optional. Automatic order: Brevo API, SMTP, console.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_TIMEOUT=30

# Production requires a separate isolated execution service (see CODE_EXECUTION.md).
# Development defaults to "development", which is NOT safe for public submissions.
CODE_EXECUTION_BACKEND=remote
CODE_EXECUTION_URL=
CODE_EXECUTION_TOKEN=
